{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "headers": [
        {
          "source": "/api/:path*",
          "headers": [
            { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
            { "key": "Cache-Control", "value": "private, no-store" }
          ]
        }
      ],
      "rewrites": [
        { "source": "/api", "destination": "https://split-travel-api.onrender.com/api" },
        { "source": "/api/:path*", "destination": "https://split-travel-api.onrender.com/api/:path*" },
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
